# EmailJS — used by the contact form (src/components/contact/ContactForm.tsx)
# Create a free account at https://www.emailjs.com, add an Email Service and
# a Template, then fill these in. Copy this file to `.env` (which is
# git-ignored) — the form works without them but shows a friendly notice
# instead of sending.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
